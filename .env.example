# Server
PORT=3000
NODE_ENV=development
API_KEY=replace-with-a-long-random-local-key
CORS_ORIGIN=*

# Portal credentials (never commit real values)
PORTAL_BASE_URL=https://urja-ops.flockenergy.tech
PORTAL_USERNAME=operator@urja.local
PORTAL_PASSWORD=replace-me

# Set true only while exploring the portal locally. Discovery output can contain
# sensitive response data; keep portal-discovery/ out of Git.
PORTAL_DISCOVERY_MODE=true

# These selectors are deliberately configurable because the live portal could
# not be inspected from the build environment. Confirm them in your browser.
PORTAL_USERNAME_SELECTOR=input[type="email"]
PORTAL_PASSWORD_SELECTOR=input[type="password"]
PORTAL_SUBMIT_SELECTOR=button[type="submit"]
PORTAL_LOGIN_SUCCESS_SELECTOR=
PORTAL_METERS_PATH=/
PORTAL_METER_DETAIL_PATH=
PORTAL_CONSUMPTION_PATH=
